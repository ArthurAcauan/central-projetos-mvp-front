# URL base da API REST do backend (repositorio separado).
# So e usada quando VITE_USE_MOCK=false. Sem ela, a chamada falha com erro de
# configuracao explicito em vez de bater na origem do proprio Vite.
VITE_API_URL=http://localhost:3000

# Camada de dados mock (ADR-0001). Ausente ou qualquer valor = ligada:
# enquanto o backend nao existe, esse e o estado normal do MVP e um clone novo
# roda sem configuracao. Apenas "false" faz o front chamar a API real (F5-1).
VITE_USE_MOCK=true

# Cenario do mock, para exercitar os estados de tela sem backend:
#   padrao (default) - seed completo com ~15 projetos
#   vazio            - listas vazias, para testar o estado vazio
#   erro             - toda chamada falha com 500, para testar o estado de erro
VITE_MOCK_SCENARIO=padrao
