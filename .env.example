# URL base da API REST do backend (repositorio separado).
# Porta 3333, nao 3000 — ver context/CONTRATO_API.md, secao 1.
# So e usada quando VITE_USE_MOCK=false. Sem ela, a chamada falha com erro de
# configuracao explicito em vez de bater na origem do proprio Vite.
VITE_API_URL=http://localhost:3333

# Camada de fixture no lugar da API (ADR-0001, revisto no ADR-0008).
# Padrao "false": o backend existe, e integrar com ele e o estado normal do
# projeto desde F5-1. Use "true" para demonstrar o front sem subir a API.
VITE_USE_MOCK=false

# Cenario da fixture, para exercitar os estados de tela sem backend.
# So tem efeito com VITE_USE_MOCK=true.
#   padrao (default) - respostas reais capturadas da API
#   vazio            - listas vazias, para testar o estado vazio
#   erro             - toda chamada falha com 500, para testar o estado de erro
VITE_MOCK_SCENARIO=padrao
